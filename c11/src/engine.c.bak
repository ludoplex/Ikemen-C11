/*
 * Ikemen C11 Engine - Core Implementation
 * Reference: src/main.go, src/config.go, src/system.go
 */

#include "ikemen_engine.h"
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdarg.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <errno.h>
#include <ctype.h>

#ifdef _WIN32
#include <direct.h>
#define mkdir(path, mode) _mkdir(path)
#endif

/* Error message buffer */
#define MAX_ERROR_LENGTH 512
static char last_error_msg[MAX_ERROR_LENGTH] = "";

/* Helper functions */

static void set_error(const char* fmt, ...) {
    va_list args;
    va_start(args, fmt);
    vsnprintf(last_error_msg, MAX_ERROR_LENGTH, fmt, args);
    va_end(args);
}

static int file_exists(const char* path) {
    struct stat st;
    return (stat(path, &st) == 0);
}

static int is_directory(const char* path) {
    struct stat st;
    if (stat(path, &st) != 0) {
        return 0;
    }
    return S_ISDIR(st.st_mode);
}

static int create_directory_if_missing(const char* path) {
    if (is_directory(path)) {
        return 1; /* Already exists */
    }
    
    if (mkdir(path, 0755) != 0) {
        if (errno != EEXIST) {
            set_error("Failed to create directory %s: %s", path, strerror(errno));
            return 0;
        }
    }
    return 1;
}

/* Version query functions */
#define IKM_VERSION_STRING_IMPL(maj, min, pat) #maj "." #min "." #pat
#define IKM_VERSION_STRING(maj, min, pat) IKM_VERSION_STRING_IMPL(maj, min, pat)

int ikm_engine_major_version(void) {
    return IKM_ENGINE_MAJOR;
}

int ikm_engine_minor_version(void) {
    return IKM_ENGINE_MINOR;
}

int ikm_engine_patch_version(void) {
    return IKM_ENGINE_PATCH;
}

const char* ikm_engine_version_string(void) {
    return IKM_VERSION_STRING(IKM_ENGINE_MAJOR, IKM_ENGINE_MINOR, IKM_ENGINE_PATCH);
}

/* Setup directories - mimics Go's os.Mkdir calls in main() */
int ikm_setup_directories(const char* base_path) {
    char path[IKM_MAX_PATH];
    const char* base = base_path ? base_path : ".";
    
    last_error_msg[0] = '\0';
    
    /* Create save/ directory */
    snprintf(path, sizeof(path), "%s/save", base);
    if (!create_directory_if_missing(path)) {
        return IKM_ERROR_IO;
    }
    
    /* Create save/replays */
    snprintf(path, sizeof(path), "%s/save/replays", base);
    if (!create_directory_if_missing(path)) {
        return IKM_ERROR_IO;
    }
    
    /* Create save/logs */
    snprintf(path, sizeof(path), "%s/save/logs", base);
    if (!create_directory_if_missing(path)) {
        return IKM_ERROR_IO;
    }
    
    return IKM_SUCCESS;
}

/* Verify system files exist - checks for key files Go engine needs */
int ikm_verify_system_files(const char* base_path) {
    char path[IKM_MAX_PATH];
    const char* base = base_path ? base_path : ".";
    
    last_error_msg[0] = '\0';
    
    /* Check data/ directory */
    snprintf(path, sizeof(path), "%s/data", base);
    if (!is_directory(path)) {
        set_error("Required directory missing: %s", path);
        return IKM_ERROR_FILE_NOT_FOUND;
    }
    
    /* Check external/ directory */
    snprintf(path, sizeof(path), "%s/external", base);
    if (!is_directory(path)) {
        set_error("Required directory missing: %s", path);
        return IKM_ERROR_FILE_NOT_FOUND;
    }
    
    /* Check font/ directory */
    snprintf(path, sizeof(path), "%s/font", base);
    if (!is_directory(path)) {
        set_error("Required directory missing: %s", path);
        return IKM_ERROR_FILE_NOT_FOUND;
    }
    
    /* Check for key data files that Go engine uses */
    snprintf(path, sizeof(path), "%s/data/system.base.def", base);
    if (!file_exists(path)) {
        set_error("System definition file not found: %s", path);
        return IKM_ERROR_FILE_NOT_FOUND;
    }
    
    return IKM_SUCCESS;
}

/* Config defaults - matches Go's defaultConfig.ini values */
void ikm_config_set_defaults(ikm_config_t* config) {
    config->width = 640;
    config->height = 480;
    config->fullscreen = 0;
    strncpy(config->system_script, "external/script/main.lua", IKM_MAX_PATH - 1);
    config->system_script[IKM_MAX_PATH - 1] = '\0';
}

/* Basic INI parser - simplified version of Go's ini.Load */
int ikm_load_config(const char* config_path, ikm_config_t* config) {
    FILE* fp;
    char line[512];
    char key[128];
    int value_int;
    
    last_error_msg[0] = '\0';
    
    /* Set defaults first */
    ikm_config_set_defaults(config);
    
    /* Try to open config file */
    fp = fopen(config_path, "r");
    if (!fp) {
        /* Config file doesn't exist yet - use defaults */
        set_error("Config file not found, using defaults: %s", config_path);
        return IKM_SUCCESS; /* Not fatal - Go engine creates it if missing */
    }
    
    /* Parse INI file */
    while (fgets(line, sizeof(line), fp)) {
        /* Skip comments and empty lines */
        char* p = line;
        while (isspace(*p)) p++;
        if (*p == '#' || *p == ';' || *p == '\0' || *p == '\n') {
            continue;
        }
        
        /* Parse key = value */
        if (sscanf(line, " GameWidth = %d", &value_int) == 1) {
            config->width = value_int;
        } else if (sscanf(line, " GameHeight = %d", &value_int) == 1) {
            config->height = value_int;
        } else if (sscanf(line, " Fullscreen = %d", &value_int) == 1) {
            config->fullscreen = value_int;
        } else if (sscanf(line, " System = %127s", key) == 1) {
            strncpy(config->system_script, key, IKM_MAX_PATH - 1);
            config->system_script[IKM_MAX_PATH - 1] = '\0';
        }
    }
    
    fclose(fp);
    return IKM_SUCCESS;
}

/* Error handling */

const char* ikm_get_last_error(void) {
    return last_error_msg;
}
